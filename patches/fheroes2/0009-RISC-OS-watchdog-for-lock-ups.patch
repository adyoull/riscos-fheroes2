+        public:
+            explicit Activity( const char * name );
+            ~Activity();
+
+            Activity( const Activity & ) = delete;
+            Activity & operator=( const Activity & ) = delete;
+
+        private:
+            const char * _previous;
+            uint64_t _previousSince;
+        };
+
+        // Called by SDL_mixer's audio thread after each mixed buffer (Mix_SetPostMix), so
+        // the watchdog can tell whether sound is still being mixed.
+        void audioAlive();
+
         // A named step: logged if it takes longer than 300 ms. Any thread.
         class Step
         {
