     // Each line has the size of the heap (the "fheroes2 Heap" dynamic areas).
+    //
+    // A stall is logged when it ends, so a lock-up that never ends would leave nothing.
+    // A watchdog thread therefore logs every 5 seconds while no event check has finished
+    // for more than 3 seconds: what the main thread is doing, the step in progress, and
+    // when sound was last mixed. (It can only run while the game is the current task, so
+    // a lock-up inside another program shows as nothing until it ends.)
     namespace Stall
     {
         bool enabled();
@@ -53,6 +59,25 @@ namespace RiscOS
         // The heap's size in bytes (all "fheroes2 Heap" areas), read at most once a second.
         uint64_t heapBytes();
 
+        // What the main thread is doing ("waiting", "drawing"), for the watchdog. Main thread.
+        class Activity
