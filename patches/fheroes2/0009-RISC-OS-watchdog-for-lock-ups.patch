+namespace
+{
+    const uint64_t watchdogStuckMs = 3000;
+    const uint64_t watchdogRepeatMs = 5000;
+
+    void watchdogThread()
+    {
+        // A timed wait on a condition that is never signalled: UnixLib's scheduler leaves
+        // the thread asleep until the timeout, so it costs nothing in between.
+        std::mutex mutex;
+        std::condition_variable never;
+        std::unique_lock<std::mutex> lock( mutex );
+        uint64_t lastReport = 0;
+
+        for ( ;; ) {
+            never.wait_for( lock, std::chrono::seconds( 1 ) );
+
+            const uint64_t now = RiscOS::Stall::ticks();
+            const uint64_t eventsEnd = lastEventsEndShared.load();
+            if ( eventsEnd == 0 || now - eventsEnd < msToTicks( watchdogStuckMs ) ) {
+                lastReport = 0;
+                continue;
+            }
+            if ( lastReport != 0 && now - lastReport < msToTicks( watchdogRepeatMs ) ) {
+                continue;
+            }
+            lastReport = now;
+
+            const uint64_t since = mainActivitySince.load();
+            const uint64_t audio = lastAudio.load();
+            std::string audioText = "never";
+            if ( audio != 0 ) {
+                audioText = std::to_string( static_cast<long>( toMs( now - audio ) ) ) + " ms ago";
+            }
+            VERBOSE_LOG( "Watchdog: no event check has finished for " << static_cast<long>( toMs( now - eventsEnd ) ) << " ms; main thread: "
+                                                                       << mainActivity.load() << " for " << static_cast<long>( toMs( now - since ) )
+                                                                       << " ms; step: " << stepName() << "; sound last mixed " << audioText << "; heap "
+                                                                       << heapMB() << " MB" )
+        }
+    }
+}
+
+RiscOS::Stall::Activity::Activity( const char * name )
+    : _previous( mainActivity.exchange( name ) )
+    , _previousSince( mainActivitySince.exchange( ticks() ) )
+{}
+
+RiscOS::Stall::Activity::~Activity()
+{
+    mainActivity.store( _previous );
+    mainActivitySince.store( _previousSince );
+}
+
+void RiscOS::Stall::audioAlive()
+{
+    lastAudio.store( ticks() );
+}
+
 bool RiscOS::Stall::enabled()
 {
     if ( enabledState < 0 ) {
@@ -148,6 +218,8 @@ void RiscOS::Stall::eventsBegin()
     }
 
     eventsStart = ticks();
+    mainActivity.store( "checking for events" );
+    mainActivitySince.store( eventsStart );
     if ( lastEventsEnd != 0 ) {
         const uint64_t span = eventsStart - lastEventsEnd;
         const uint64_t busy = span > waitedSinceEvents ? span - waitedSinceEvents : 0;
@@ -167,6 +239,12 @@ void RiscOS::Stall::eventsEnd()
     }
 
     lastEventsEnd = ticks();
+    lastEventsEndShared.store( lastEventsEnd );
+    mainActivity.store( "game code" );
+    mainActivitySince.store( lastEventsEnd );
+    if ( !watchdogStarted.exchange( true ) ) {
+        std::thread( watchdogThread ).detach();
+    }
     const uint64_t took = lastEventsEnd - eventsStart;
     if ( took > msToTicks( stallMs ) ) {
         VERBOSE_LOG( "Stall: checking for events took " << toMs( took ) << " ms (the desktop or another program held the computer); step: " << stepName()
diff --git a/src/engine/riscos.h b/src/engine/riscos.h
