 // UnixLib: the C heap goes in a dynamic area with this name, so the WimpSlot only has
 // to hold the program. UnixLib 5.0.3.1 adds more areas ("fheroes2 Heap 2"...) if one
 // isn't enough, and removes them all when the program ends.
@@ -57,4 +76,176 @@ void RiscOS::redirectOutput()
     (void)freopen( "/dev/null", "w", stderr );
 }
 
+namespace
+{
+    // Longer than this is a stall worth logging.
+    const uint64_t stallMs = 500;
+    const uint64_t stepMs = 300;
+
+    int enabledState = -1;
+
+    // Main thread only.
+    uint64_t eventsStart = 0;
+    uint64_t lastEventsEnd = 0;
+    uint64_t waitedSinceEvents = 0;
+
+    // The step in progress (any thread), for the log.
+    std::atomic<const char *> currentStep{ nullptr };
+    // The last step that ended since the previous event check.
+    std::atomic<const char *> endedStep{ nullptr };
+
+    // Read from any thread.
+    std::atomic<uint64_t> heapCache{ 0 };
+    std::atomic<uint64_t> heapRead{ 0 };
+
+    double toMs( const uint64_t ticks )
+    {
+        const uint64_t frequency = SDL_GetPerformanceFrequency();
+        return frequency == 0 ? 0.0 : static_cast<double>( ticks ) * 1000.0 / static_cast<double>( frequency );
+    }
+
+    uint64_t msToTicks( const uint64_t ms )
+    {
+        return ms * SDL_GetPerformanceFrequency() / 1000;
+    }
+
+    double heapMB()
+    {
+        return static_cast<double>( RiscOS::Stall::heapBytes() ) / ( 1024.0 * 1024.0 );
+    }
+
+    const char * stepName()
+    {
+        const char * step = currentStep.load();
+        return step != nullptr ? step : "none";
+    }
+
+    const char * endedStepName()
+    {
+        const char * step = endedStep.load();
+        return step != nullptr ? step : "none";
+    }
+}
+
+bool RiscOS::Stall::enabled()
+{
+    if ( enabledState < 0 ) {
+        const char * log = getenv( "fheroes2$Log" );
+        enabledState = ( log != nullptr && *log != '\0' ) ? 1 : 0;
+    }
+    return enabledState == 1;
+}
+
+uint64_t RiscOS::Stall::ticks()
+{
+    return SDL_GetPerformanceCounter();
+}
+
+void RiscOS::Stall::eventsBegin()
+{
+    if ( !enabled() ) {
+        return;
+    }
+
+    eventsStart = ticks();
+    if ( lastEventsEnd != 0 ) {
+        const uint64_t span = eventsStart - lastEventsEnd;
+        const uint64_t busy = span > waitedSinceEvents ? span - waitedSinceEvents : 0;
+        if ( busy > msToTicks( stallMs ) ) {
+            VERBOSE_LOG( "Stall: the game ran " << toMs( busy ) << " ms without checking for events (the desktop could not run); step: " << stepName()
+                                                  << ", last step ended: " << endedStepName() << "; heap " << heapMB() << " MB" )
+        }
+    }
+    waitedSinceEvents = 0;
+    endedStep.store( nullptr );
+}
+
+void RiscOS::Stall::eventsEnd()
+{
+    if ( !enabled() ) {
+        return;
+    }
+
+    lastEventsEnd = ticks();
+    const uint64_t took = lastEventsEnd - eventsStart;
+    if ( took > msToTicks( stallMs ) ) {
+        VERBOSE_LOG( "Stall: checking for events took " << toMs( took ) << " ms (the desktop or another program held the computer); step: " << stepName()
+                                                           << "; heap " << heapMB() << " MB" )
+    }
+}
+
+void RiscOS::Stall::waited( const uint32_t requestedMs, const uint64_t startTicks )
+{
+    if ( !enabled() ) {
+        return;
+    }
+
+    const uint64_t took = ticks() - startTicks;
+    waitedSinceEvents += took;
+    if ( took > msToTicks( requestedMs + stallMs ) ) {
+        VERBOSE_LOG( "Stall: a wait of " << requestedMs << " ms took " << toMs( took ) << " ms (the desktop or another program held the computer); step: "
+                                         << stepName() << "; heap " << heapMB() << " MB" )
+    }
+}
+
+uint64_t RiscOS::Stall::heapBytes()
+{
+    const uint64_t now = ticks();
+    const uint64_t read = heapRead.load();
+    if ( read != 0 && now - read < SDL_GetPerformanceFrequency() ) {
+        return heapCache.load();
+    }
+    heapRead.store( now );
+
+    // OS_DynamicArea 3 lists the areas, OS_DynamicArea 2 gives each one's size (R2) and name (R8).
+    uint64_t total = 0;
+    int area = -1;
+    for ( int guard = 0; guard < 4096; ++guard ) {
+        _kernel_swi_regs regs;
+        regs.r[0] = 3;
+        regs.r[1] = area;
+        if ( _kernel_swi( 0x66, &regs, &regs ) != nullptr ) {
+            break;
+        }
+        area = regs.r[1];
+        if ( area == -1 ) {
+            break;
+        }
+
+        _kernel_swi_regs info;
+        info.r[0] = 2;
+        info.r[1] = area;
+        if ( _kernel_swi( 0x66, &info, &info ) != nullptr ) {
+            continue;
+        }
+        const char * name = reinterpret_cast<const char *>( info.r[8] );
+        if ( name != nullptr && std::strncmp( name, __dynamic_da_name, std::strlen( __dynamic_da_name ) ) == 0 ) {
+            total += static_cast<uint32_t>( info.r[2] );
+        }
+    }
+
+    heapCache.store( total );
+    return total;
+}
+
+RiscOS::Stall::Step::Step( const char * name )
+    : _name( name )
+    , _previous( currentStep.exchange( name ) )
+    , _start( enabled() ? ticks() : 0 )
+{}
+
+RiscOS::Stall::Step::~Step()
+{
+    currentStep.store( _previous );
+    endedStep.store( _name );
+    if ( !enabled() ) {
+        return;
+    }
+
+    const uint64_t took = ticks() - _start;
+    if ( took > msToTicks( stepMs ) ) {
+        VERBOSE_LOG( "Slow step: " << _name << " took " << toMs( took ) << " ms; heap " << heapMB() << " MB" )
+    }
+}
+
 #endif
