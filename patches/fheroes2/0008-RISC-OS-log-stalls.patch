@@ -27,5 +29,45 @@ namespace RiscOS
     // Sends stdout and stderr to the file named by fheroes2$Log (a UnixLib
     // file name), or nowhere when it isn't set.
     void redirectOutput();
+
+    // Stall log (only when there is a log, fheroes2$Log): records in the log when the game
+    // stops for longer than half a second, and why, as far as the game can tell:
+    // - the game ran without checking for events (nothing else on the desktop could run);
+    // - checking for events (Wimp_Poll) took long: other programs held the computer;
+    // - a wait took much longer than asked;
+    // - a named step (saving, starting music) took long.
+    // Each line has the size of the heap (the "fheroes2 Heap" dynamic areas).
+    namespace Stall
+    {
+        bool enabled();
+
+        // Around the SDL event check in LocalEvent::HandleEvents (main thread).
+        void eventsBegin();
+        void eventsEnd();
+
+        // After a wait of 'requestedMs' that started at 'startTicks' (main thread).
+        void waited( uint32_t requestedMs, uint64_t startTicks );
+
+        uint64_t ticks();
+
+        // The heap's size in bytes (all "fheroes2 Heap" areas), read at most once a second.
+        uint64_t heapBytes();
+
+        // A named step: logged if it takes longer than 300 ms. Any thread.
+        class Step
+        {
+        public:
+            explicit Step( const char * name );
+            ~Step();
+
+            Step( const Step & ) = delete;
+            Step & operator=( const Step & ) = delete;
+
+        private:
+            const char * _name;
+            const char * _previous;
+            uint64_t _start;
+        };
+    }
 }
 #endif
