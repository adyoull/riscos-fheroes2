diff --git a/src/engine/riscos.cpp b/src/engine/riscos.cpp
index bf05b1c..933e6ea 100644
--- a/src/engine/riscos.cpp
+++ b/src/engine/riscos.cpp
@@ -22,11 +22,30 @@
 
 #include "riscos.h"
 
