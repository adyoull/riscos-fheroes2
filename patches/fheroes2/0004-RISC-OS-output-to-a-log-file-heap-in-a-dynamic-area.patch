+ *   along with this program; if not, write to the                         *
+ *   Free Software Foundation, Inc.,                                       *
+ *   59 Temple Place - Suite 330, Boston, MA  02111-1307, USA.             *
+ ***************************************************************************/
+
+#if defined( __riscos__ )
+
+#include "riscos.h"
+
+#include <cstdio>
+#include <cstdlib>
+
+#include <unistd.h>
+
+// UnixLib: the C heap goes in a dynamic area with this name, so the WimpSlot only has
+// to hold the program. UnixLib 5.0.3.1 adds more areas ("fheroes2 Heap 2"...) if one
+// isn't enough, and removes them all when the program ends.
+// (Declared, extern and weak, in UnixLib's features.h.)
+const char * const __dynamic_da_name = "fheroes2 Heap";
+int __dynamic_da_max_size = 512 * 1024 * 1024;
+
+void RiscOS::redirectOutput()
+{
+    const char * name = getenv( "fheroes2$Log" );
+    if ( name == nullptr || *name == '\0' ) {
+        name = "/dev/null";
+    }
+
+    // RISC OS lets a file be opened for writing only once, so open it for stderr and
+    // give stdout the same handle.
+    if ( freopen( name, "w", stderr ) != nullptr ) {
+        setvbuf( stderr, nullptr, _IOLBF, 0 );
+        fflush( stdout );
+        if ( dup2( fileno( stderr ), fileno( stdout ) ) >= 0 ) {
+            return;
+        }
+        (void)freopen( "/dev/null", "w", stdout );
+        return;
+    }
+
+    (void)freopen( "/dev/null", "w", stdout );
+    (void)freopen( "/dev/null", "w", stderr );
+}
+
+#endif
